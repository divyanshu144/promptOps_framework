# Local configuration. Docker Compose overrides service URLs and storage paths.
OLLAMA_URL=http://localhost:11434

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# SQLite database path
PROMPTOPS_DB=./promptops.db

# MLflow tracking URI
MLFLOW_TRACKING_URI=./mlruns

# OpenAI API key (only needed if using provider=openai)
OPENAI_API_KEY=

# Anthropic API key (only needed if using provider=anthropic)
ANTHROPIC_API_KEY=

# Mistral API key (only needed if using provider=mistral)
MISTRAL_API_KEY=

# For the frontend, use frontend/.env.local (copy frontend/.env.example).
# Frontend: API URL seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend: MLflow URL seen from the browser
NEXT_PUBLIC_MLFLOW_URL=http://localhost:5000
